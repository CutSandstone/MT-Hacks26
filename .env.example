# Copy to .env.
# Inference provider: 'devin' = local Devin Gateway (default, no credentials
# needed); 'snowflake' = Snowflake Cortex AI_COMPLETE (requires the Snowflake
# settings below). There is no fallback between providers.
INFERENCE_PROVIDER=devin

# Devin Gateway: local OpenAI-compatible endpoint serving the app by default.
DEVIN_GATEWAY_BASE_URL=http://127.0.0.1:3001
DEVIN_GATEWAY_MODEL=swe-2-high

# Optional Snowflake Cortex — only used when INFERENCE_PROVIDER=snowflake.
# Free 120-day student trial: https://signup.snowflake.com
# Account locator including region, e.g. ABC12345.us-east-1 (from your trial account URL)
SNOWFLAKE_ACCOUNT=
# Programmatic Access Token: Snowsight -> user -> Settings -> Authentication -> PAT
SNOWFLAKE_PAT=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# Must be a model AI_COMPLETE supports structured output (response_format) on.
SNOWFLAKE_MODEL=mistral-large3
# PORT=8000
